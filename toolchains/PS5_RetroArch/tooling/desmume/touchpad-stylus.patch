+// A slim, rounded stylus with a tapered nib at the exact touch coordinate.
+// Rasterise the outline at the current resolution rather than enlarging a bitmap.
+static void DrawStylus(uint16_t* output, unsigned pitch, int width, int height,
+                       int x, int y, int size)
+{
+   const uint32_t body = pointer_color_32;
+   const uint32_t edge = body == 0 ? 0xffffff : 0x202830;
+   for (int py = std::max(0, y - 21 * size); py < std::min(height, y + 2 * size); ++py)
+      for (int px = std::max(0, x - 2 * size); px < std::min(width, x + 17 * size); ++px)
+      {
+         uint32_t original;
+         if (colorMode == RETRO_PIXEL_FORMAT_XRGB8888)
+            original = reinterpret_cast<uint32_t*>(output)[py * pitch + px];
+         else
+         {
+            uint16_t c = output[py * pitch + px];
+            original = ((c >> 11) * 255 / 31 << 16) |
+                       (((c >> 5) & 63) * 255 / 63 << 8) | ((c & 31) * 255 / 31);
+         }
+         unsigned red = 0, green = 0, blue = 0, covered = 0;
+         for (int sy = 0; sy < 2; ++sy)
+            for (int sx = 0; sx < 2; ++sx)
+            {
+               const float dx = (px - x + (sx - 0.5f) * 0.5f) / size;
+               const float dy = (py - y + (sy - 0.5f) * 0.5f) / size;
+               const float along = dx * 0.6f - dy * 0.8f;
+               const float side = dx * 0.8f + dy * 0.6f;
+               const float radius = std::min(1.6f, along * 0.32f);
+               const float cap = std::max(0.0f, along - 22.0f);
+               uint32_t colour = original;
+               if (along >= 0 && side * side + cap * cap <= radius * radius)
+               {
+                  ++covered;
+                  // Dark tip, outline and end cap; light barrel with a fine seam.
+                  colour = along > 5.0f && along < 20.5f &&
+                           std::abs(side) < radius - 0.45f ? body : edge;
+               }
+               red += (colour >> 16) & 255;
+               green += (colour >> 8) & 255;
+               blue += colour & 255;
+            }
+         if (!covered)
+            continue;
+         red /= 4; green /= 4; blue /= 4;
+         if (colorMode == RETRO_PIXEL_FORMAT_XRGB8888)
+            reinterpret_cast<uint32_t*>(output)[py * pitch + px] = (red << 16) | (green << 8) | blue;
+         else
+            output[py * pitch + px] = ((red >> 3) << 11) | ((green >> 2) << 5) | (blue >> 3);
+      }
 }
 
