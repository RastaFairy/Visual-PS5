     if (!mSystemListView)
         getSystemListView();
 
+#if defined(__PROSPERO__)
+    // PS5: back from a game RetroArch ran (game mode): count the play, add the time
+    // RetroArch ran, and open the system's game list on the game.
+    {
+        char systemName[256] {};
+        char gamePath[1024] {};
+        char error[256] {};
+        long seconds {0};
+        int status {0};
+        if (ps5_esde_game_return(systemName, sizeof(systemName), gamePath, sizeof(gamePath),
+                                 &seconds, &status, error, sizeof(error))) {
+            SystemData* system {nullptr};
+            for (auto it : SystemData::sSystemVector) {
+                if (it->getName() == systemName)
+                    system = it;
+            }
+            FileData* game {nullptr};
+            if (system != nullptr) {
+                for (auto file : system->getRootFolder()->getFilesRecursive(GAME)) {
+                    if (file->getSourceFileData()->getPath() == gamePath) {
+                        game = file;
+                        break;
+                    }
+                }
+            }
+            if (status < 0) {
+                LOG(LogError) << "Game mode refused the game: " << error;
+                Window::getInstance()->queueInfoPopup(
+                    Utils::String::format(_("ERROR LAUNCHING GAME: %s"),
+                                          Utils::String::toUpper(error).c_str()),
+                    8000);
+            }
+            if (game != nullptr) {
+                goToGamelist(system);
+                getGamelistView(system)->setCursor(game);
+                if (status >= 0) {
+                    FileData* source {game->getSourceFileData()};
+                    LOG(LogInfo) << "Back from \"" << source->metadata.get("name") << "\" after "
+                                 << seconds << " seconds in RetroArch (status " << status << ")";
+                    source->metadata.set(
+                        "playcount",
+                        std::to_string(static_cast<long long>(source->metadata.getInt("playcount") + 1)));
+                    Settings::getInstance()->setInt(
+                        "GameLaunchTime",
+                        static_cast<int>(Utils::Time::DateTime(Utils::Time::now()).getTime() - seconds));
+                    game->setPlayMetadata(false);
+                    CollectionSystemsManager::getInstance()->refreshCollectionSystems(source);
+                    source->getSystem()->onMetaDataSavePoint();
+                }
+                cancelViewTransitions();
+                return;
+            }
+        }
+    }
+#endif
+
     // If a specific system is requested then go directly to this system, which could be either
     // the system view or the gamelist view.
     std::string requestedSystem {Settings::getInstance()->getString("StartupSystem")};
