+#ifdef __PROSPERO__
+// PlayStation 5: the buttons' colours. The game draws a button as a white shape tinted by its
+// layout (green for A) with the letter over it, and the port replaces the letters with the
+// DualSense's symbols (ps5/art/make-glyphs.py). A cross belongs on blue, so around each picture
+// that shows the A letter (a 32x46 intensity texture) green tints become that blue. Circle is
+// red on both pads and stays.
+#include <cstdio>
+#include <cstdlib>
+namespace {
+bool ps5_is_picture(J2DPane* pane) {
+    return pane->getTypeID() == 18;
+}
+bool ps5_is_letter_a(J2DPane* pane) {
+    if (!ps5_is_picture(pane)) return false;
+    JUTTexture* texture = static_cast<J2DPicture*>(pane)->getTexture(0);
+    const ResTIMG* info = texture != NULL ? texture->getTexInfo() : NULL;
+    return info != NULL && info->width == 32 && info->height == 46 && info->format == 0;
+}
+bool ps5_green(const JUtility::TColor& c) {
+    return c.g >= 60 && c.g > c.r + c.r / 3 && c.g > c.b + c.b / 3;
+}
+JUtility::TColor ps5_blue(const JUtility::TColor& c) {
+    return JUtility::TColor(u8(c.r * 0.55f), u8(c.g * 0.62f), c.g, c.a);
+}
+void ps5_recolour(J2DPane* pane, J2DPane* letter, int depth, bool log) {
+    if (pane != letter && ps5_is_picture(pane)) {
+        J2DPicture* picture = static_cast<J2DPicture*>(pane);
+        JUtility::TColor black = picture->getBlack(), white = picture->getWhite();
+        if (log) {
+            std::printf("[ps5 buttons] %*s%08llx white %08x black %08x\n", depth * 2, "",
+                        (unsigned long long)pane->mInfoTag, (unsigned)(u32)white, (unsigned)(u32)black);
+        }
+        if (ps5_green(white) || ps5_green(black)) {
+            picture->setBlackWhite(ps5_green(black) ? ps5_blue(black) : black,
+                                   ps5_green(white) ? ps5_blue(white) : white);
+        }
+    }
+    for (J2DPane* child = pane->getFirstChildPane(); child != NULL; child = child->getNextChildPane()) {
+        ps5_recolour(child, letter, depth + 1, log);
+    }
+}
+void ps5_button_colours(J2DPane* pane) {
+    static const bool log = std::getenv("PS5_BUTTON_LOG") != NULL || std::fopen("/app0/button-log", "r") != NULL;
+    for (J2DPane* child = pane->getFirstChildPane(); child != NULL; child = child->getNextChildPane()) {
+        if (ps5_is_letter_a(child)) {
+            if (log) std::printf("[ps5 buttons] A letter %08llx under %08llx\n",
+                                 (unsigned long long)child->mInfoTag, (unsigned long long)pane->mInfoTag);
+            ps5_recolour(pane, child, 0, log);
+        }
+        ps5_button_colours(child);
+    }
+}
+}
+#endif
